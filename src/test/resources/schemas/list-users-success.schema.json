{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "List users response",
  "type": "object",
  "required": [
    "quantidade",
    "usuarios"
  ],
  "properties": {
    "quantidade": {
      "type": "integer",
      "minimum": 0
    },
    "usuarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nome",
          "email",
          "password",
          "administrador",
          "_id"
        ],
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "administrador": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          },
          "_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
