{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["nome", "email", "password", "administrador", "_id"],
  "properties": {
    "nome": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "administrador": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
